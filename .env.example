# Optional configuration template. Simulation and explicit demo mode need no API keys.
# Copy to ignored .env and run: python -m scripts.run_backend --reload
# Plain Uvicorn uses shell variables; the local launcher loads supported .env settings.
ECONOMY_DB_PATH=data/economy.sqlite3
ECONOMY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Live central-bank, business, and bank agents: select a tool-capable Nemotron model.
# Leave these blank for demo-only use. Never commit a real API key.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional Fetch ASI:One research model (distinct from an Agentverse API token).
ASI1_API_KEY=
ASI1_MODEL=asi1-mini
# Fetch ACP gateway identity and mailbox registration, kept private.
FETCH_AGENT_SEED=
FETCH_AGENTVERSE_TOKEN=
# Alternatively use an externally reachable /submit endpoint instead of mailbox.
FETCH_AGENT_ENDPOINT=

# CRS sandbox: obtain these and the product config from the sponsor portal.
# Use a bearer token OR username/password. Only sponsor test identities are used.
CRS_ACCESS_TOKEN=
CRS_USERNAME=
CRS_PASSWORD=
CRS_PRODUCT_CONFIG=
CRS_TEST_PROFILES_PATH=data/crs-test-profiles.json
CRS_DECISION_RULES_PATH=data/crs-decision-rules.json

# Optional CRS bank-underwriting data; configure the sponsor's enabled product.
CRS_CREDIT_PRODUCT_CONFIG=
CRS_CREDIT_REPORT_VARIANT=standard
CRS_CREDIT_RULES_PATH=data/crs-credit-rules.json
# Optional global credit review threshold, integer cents. Blank preserves existing defaults.
CREDIT_APPROVAL_THRESHOLD_CENTS=

# Optional calibrated retail prices and daily wages from explicit Apify Actor runs.
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_CALIBRATION_DIR=data/calibrations

# Optional external research payments: BASE SEPOLIA ONLY, never a mainnet wallet.
X402_WALLET_PRIVATE_KEY=
X402_MERCHANT_ADDRESS=
X402_FORECAST_URL=http://127.0.0.1:8402
# Absolute isolated Python path; blank uses the local .venv-x402 automatically.
# X402_PYTHON=C:/absolute/path/to/Calhacks/.venv-x402/Scripts/python.exe

# Publish the event module with the SAME identity whose token is supplied here.
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=economy-god-mode
SPACETIMEDB_TOKEN=
